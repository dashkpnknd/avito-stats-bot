# Obtain the bot token from BotFather. Never commit a real .env file.
BOT_TOKEN=
# Telegram user IDs allowed to manage the bot, separated by commas.
ADMIN_IDS=
# Comma-separated Telegram usernames allowed to manage projects in private chat.
ADMIN_USERNAMES=
# Optional IDs for error notifications; defaults to ADMIN_IDS.
ADMIN_ALERT_CHAT_IDS=
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

TIMEZONE=Europe/Moscow
DAILY_REPORT_HOUR=10
DAILY_REPORT_MINUTE=0
WEEKLY_REPORT_HOUR=10
WEEKLY_REPORT_MINUTE=0
MONTHLY_REPORT_HOUR=10
MONTHLY_REPORT_MINUTE=0
DB_NAME=data/avito_stats.sqlite3

# Current-balance monitoring. Total balance is Wallet + Advance.
LOW_BALANCE_THRESHOLD=3000
LOW_BALANCE_CHECK_MINUTES=60
LOW_BALANCE_REMINDER_HOURS=24
# ID of a private Avitologist group/channel. Add the bot there as an admin.
LOW_BALANCE_ALERT_CHAT_ID=

# Keep the default two until other metric names have been verified in Avito API.
AVITO_STATS_FIELDS=uniqViews,uniqContacts
AVITO_ITEM_STATUSES=active,old
